# API Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

# OpenRouter API Key (Required)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Redis
REDIS_URL=redis://localhost:6379

# Gateway Configuration
CACHE_TTL_SECONDS=3600
ROUTER_TIMEOUT_MS=5000
INFERENCE_TIMEOUT_MS=30000
MAX_RETRIES=3
MAX_REQUESTS_PER_MINUTE=100

# OpenRouter Pricing (per 1M tokens) - via OpenRouter
HAIKU_INPUT_COST=0.25
HAIKU_OUTPUT_COST=1.25
SONNET_INPUT_COST=3.0
SONNET_OUTPUT_COST=15.0
GPT4O_INPUT_COST=2.50
GPT4O_OUTPUT_COST=10.0

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT_SECONDS=60

# Guardrails
ENABLE_PROMPT_INJECTION_DETECTION=true
ENABLE_TOXICITY_FILTER=true
ENABLE_PII_REDACTION=true
MAX_PROMPT_LENGTH_TOKENS=8000

# Dashboard
DASHBOARD_PORT=7860
MOCK_MODE=false

# Monitoring
PROMETHEUS_MULTIPROCESS_DIR=
METRICS_RETENTION_DAYS=7
